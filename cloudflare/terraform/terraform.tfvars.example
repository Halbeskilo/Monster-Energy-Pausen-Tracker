# Kopiere diese Datei nach terraform.tfvars (wird von Git ignoriert!) und trage deine beiden Werte ein:
#   cp terraform.tfvars.example terraform.tfvars

cloudflare_api_token  = "DEIN_CLOUDFLARE_API_TOKEN"
cloudflare_account_id = "DEINE_CLOUDFLARE_ACCOUNT_ID"
workers_dev_subdomain = "dein-workers-subdomain"

d1_database_name = "monster-db"
worker_name      = "monster-pausen-api"

# Optional: zusätzlich einen Deploy-Token für GitHub Actions anlegen
# (cloudflare_api_token braucht dafür das Recht "Account API Tokens Write")
create_deploy_token = false
